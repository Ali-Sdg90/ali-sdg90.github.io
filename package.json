{
  "name": "ali-sdg90-portfolio",
  "private": true,
  "version": "1.41.4",
  "description": "Ali Sadeghi's interactive portfolio, featuring selected projects, technical skills, career journey, and impact.",
  "homepage": "https://ali-sdg.is-a.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ali-Sdg90/ali-sdg90.github.io.git"
  },
  "author": {
    "name": "Ali Sadeghi",
    "url": "https://github.com/Ali-Sdg90"
  },
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "portfolio",
    "software-engineer",
    "systems-designer",
    "react",
    "vite",
    "frontend",
    "web-development"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:debug": "vite --host localhost --port 5173 --strictPort",
    "mobile": "vite --host 0.0.0.0 --port 5173",
    "image:opt": "node scripts/optimize-images.mjs",
    "prebuild": "npm run image:opt",
    "build": "npm run generate:ssg",
    "generate:ssg": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "release": "semantic-release",
    "prepare": "husky",
    "check": "npm run format:check && npm run lint && npm run test && npm run build && echo ✅ Everything is OK"
  },
  "dependencies": {
    "framer-motion": "^12.40.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.18.5",
    "sass": "^1.100.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.7.4",
    "semantic-release": "^25.0.3",
    "sharp": "^0.35.5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
